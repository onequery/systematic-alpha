# Non-sensitive runtime config for trader pipeline.
# Precedence: existing process env > .env > this file.
# Secrets must stay in .env.

TRADER_EXECUTION_MODE=mojito_mock
TRADER_PROFILE=prod
TRADER_ORDER_ENABLED_MARKETS=KR,US

# Strategy: Larry Williams breakout
TRADER_BREAKOUT_K=0.5
TRADER_PER_TRADE_RATIO=0.12
TRADER_MAX_POS_KR=3
TRADER_MAX_POS_US=3
TRADER_MAX_POS_TOTAL=6
TRADER_CANDIDATES_MAX_KR=20
TRADER_CANDIDATES_MAX_US=20

# Daily schedule (KST)
TRADER_PRECOMPUTE_START_KST=08:05
TRADER_PRECOMPUTE_END_KST=08:33
TRADER_COOLDOWN_START_KST=08:33
TRADER_COOLDOWN_END_KST=08:38
TRADER_BUDGET_SNAPSHOT_KST=08:40

# Liquidation
TRADER_KR_LIQUIDATION_START_KST=15:10
TRADER_KR_LIQUIDATION_RETRY_KST=15:18
TRADER_KR_LIQUIDATION_FINAL_KST=15:19:30
TRADER_US_LIQUIDATION_LEAD_MINUTES=20
TRADER_US_LIQUIDATION_RETRY_MINUTES=5
TRADER_US_LIQUIDATION_FINAL_SECONDS=30

# Broker/API pacing
TRADER_BROKER_GLOBAL_SERIALIZE=1
TRADER_BROKER_GLOBAL_MIN_INTERVAL_SEC=1.2
TRADER_US_SYNC_EXCHANGES=NASD,NYSE,AMEX
TRADER_US_REQUIRE_ALL_EXCHANGES=1
TRADER_US_EXCHANGE_SPACING_SEC=2.0
TRADER_US_DAYORNIGHT_CALL_SPACING_SEC=0.4
TRADER_US_OHLCV_RATE_RETRIES=2
TRADER_US_OHLCV_RATE_BACKOFF_SEC=1.2
TRADER_US_OHLCV_EXCHANGE_SPACING_SEC=0.8
TRADER_US_OHLCV_STRICT_PRIMARY_EXCHANGE=1
TRADER_RATE_LIMIT_RETRIES=3
TRADER_RATE_LIMIT_BACKOFF_SEC=2.0
TRADER_RATE_LIMIT_BACKOFF_MAX_SEC=20.0

# Sync policy
TRADER_SYNC_STRICT=1
TRADER_SYNC_MAX_STALENESS_SEC=30

# Universe/filter
TRADER_REST_SLEEP_SEC=0.06
TRADER_MARKET_FILTER_SYMBOL_KR=069500
TRADER_MARKET_FILTER_SYMBOL_US=SPY
TRADER_MARKET_FILTER_MA_DAYS=20

# Runtime cadence
TRADER_POLL_SECONDS=60
TRADER_STRATEGY_CYCLE_SECONDS=600
TRADER_FALLBACK_POLL_SECONDS=3
TRADER_ENTRY_COOLDOWN_MINUTES=10

# Telegram
TELEGRAM_ENABLED=1
TELEGRAM_DISABLE_NOTIFICATION=0
